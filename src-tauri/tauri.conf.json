{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Telegram User Activities",
  "version": "0.2.0",
  "identifier": "de.telegram-user-activities",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Telegram User Activities",
        "width": 1000,
        "height": 750,
        "minWidth": 800,
        "minHeight": 620,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDFCOTE0MjRBOTY4MTgwOUIKUldTYmdJR1dTa0tSR3o4bW5rd0RzQzEwTHpteXRLajlCY2lmN1ZrNi9ZL2pNZU1YcTVkOHU0SjEK",
      "endpoints": [
        "https://github.com/MiSte-Git/TUA/releases/latest/download/latest.json"
      ]
    }
  }
}
